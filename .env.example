# Claude API key. Used on the host only; never mounted into the sandbox.
ANTHROPIC_API_KEY=sk-ant-...

# GitHub token with repo scope (issues, contents, pull requests). Host only.
GITHUB_TOKEN=ghp_...

# "anthropic" (default) calls the Claude API. "mock" replays a recorded trajectory
# from evals/fixtures/mock so tests and CI run without a key or network.
LLM_PROVIDER=anthropic

# Optional overrides
# AUTOFIX_MODEL=claude-opus-5-5
# AUTOFIX_SANDBOX=docker      # docker (default) or local
# AUTOFIX_BASE_IMAGE=autofix-sandbox:latest
